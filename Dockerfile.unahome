FROM python:3.12-slim
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends librsvg2-bin ca-certificates curl fontconfig fonts-dejavu-core fonts-firacode \
 && pip install --no-cache-dir pyyaml pillow \
 && mkdir -p /usr/share/fonts/truetype/fira \
 && ( for w in Regular Medium SemiBold Bold; do \
        curl -fsSL -o "/usr/share/fonts/truetype/fira/FiraSans-$w.ttf" \
          "https://raw.githubusercontent.com/google/fonts/main/ofl/firasans/FiraSans-$w.ttf" || echo "missing FiraSans-$w"; \
      done ) \
 ; fc-cache -f \
 ; rm -rf /var/lib/apt/lists/*

RUN fc-list | grep -ci fira || true
WORKDIR /w
CMD ["python3", "build_unahome.py"]
